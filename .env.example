# Copy into .dev.vars for local Wrangler. These are SERVER values, never VITE_*.
APP_ORIGIN=https://example.com
# Fill SITE_ORIGIN only after confirming and configuring the production domain.
SITE_ORIGIN=
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
ANALYTICS_ENABLED=false
SUPABASE_URL=https://PROJECT.supabase.co
# The existing variable names accept modern sb_publishable_ and sb_secret_ keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_EMBED_TOKEN_KEY=
BUNNY_SECURITY_CONFIRMED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_LIVE_MODE=false
PAYMENTS_ENABLED=false
